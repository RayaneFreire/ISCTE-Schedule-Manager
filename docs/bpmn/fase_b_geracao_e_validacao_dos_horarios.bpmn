      <bpmn:outgoing>Flow_G1_B7_Sim</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_B9_Nao</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="B7" name="B7 - Ajustar&#10;Proposta de Horário">
