    <bpmn:sequenceFlow id="Flow_G1_B9_Nao" name="Não" sourceRef="G_XOR_1" targetRef="B9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">conflitos = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
