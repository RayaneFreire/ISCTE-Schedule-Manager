<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_FaseC" targetNamespace="http://iscte.pt/schedule-manager/bpmn" exporter="Camunda Web Modeler" exporterVersion="5acd1b5" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_FaseC">
    <bpmn:participant id="Participant_FaseC" name="Fase C - Aprovação e Publicação dos Horários" processRef="Process_FaseC" />
  </bpmn:collaboration>
  <bpmn:process id="Process_FaseC" name="Fase C - Aprovação e Publicação dos Horários" isExecutable="false">
    <bpmn:laneSet id="LaneSet_FaseC">
      <bpmn:lane id="Lane_Sistema" name="Sistema">
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Gestor" name="Gestor Académico">
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Retorno</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E1" name="E1 - Início&#10;da Aprovação">
      <bpmn:outgoing>Flow_E1_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="C1" name="C1 - Analisar&#10;Horário Validado">
      <bpmn:incoming>Flow_E1_C1</bpmn:incoming>
      <bpmn:outgoing>Flow_C1_C2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C2" name="C2 - Verificar&#10;Consistência Final">
      <bpmn:incoming>Flow_C1_C2</bpmn:incoming>
      <bpmn:outgoing>Flow_C2_G1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="G1 - Horário&#10;Aprovado?">
      <bpmn:incoming>Flow_C2_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_C3_Nao</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_C4_Sim</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="C3" name="C3 - Solicitar&#10;Ajustamentos">
      <bpmn:incoming>Flow_G1_C3_Nao</bpmn:incoming>
      <bpmn:outgoing>Flow_C3_Retorno</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C4" name="C4 - Consolidar&#10;Horário Final">
      <bpmn:incoming>Flow_G1_C4_Sim</bpmn:incoming>
      <bpmn:outgoing>Flow_C4_C5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C5" name="C5 - Publicar Horário">
      <bpmn:incoming>Flow_C4_C5</bpmn:incoming>
      <bpmn:outgoing>Flow_C5_E2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E2" name="E2 - Horário&#10;Publicado">
      <bpmn:incoming>Flow_C5_E2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E_Retorno" name="Retorno à Fase B">
      <bpmn:incoming>Flow_C3_Retorno</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_E1_C1" name="Entrada da Fase B" sourceRef="E1" targetRef="C1" />
    <bpmn:sequenceFlow id="Flow_C1_C2" sourceRef="C1" targetRef="C2" />
    <bpmn:sequenceFlow id="Flow_C2_G1" sourceRef="C2" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_G1_C3_Nao" name="Não" sourceRef="G1" targetRef="C3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aprovado = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G1_C4_Sim" name="Sim" sourceRef="G1" targetRef="C4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">aprovado = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C3_Retorno" name="Para ajustamento e revalidação" sourceRef="C3" targetRef="E_Retorno" />
    <bpmn:sequenceFlow id="Flow_C4_C5" sourceRef="C4" targetRef="C5" />
    <bpmn:sequenceFlow id="Flow_C5_E2" sourceRef="C5" targetRef="E2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_FaseC">
    <bpmndi:BPMNPlane id="BPMNPlane_FaseC" bpmnElement="Collaboration_FaseC">
